/*
====================
components.def

Single-source component registry for the ECS.
Structured as a hierarchical preprocessor DSL.
Repeatedly included by `reflect.h` and `reflect.c`
to generate struct definitions, component ID enums,
reflection metadata tables, and default instances.

Syntax:
    COMP(name)
        FIELD(type, name, default_value)            -- Scalar field
        FIELD(type, name, count, default_value)     -- Fixed-size array field
    COMP_END(name)

All components MUST be POD with zero heap pointers.
====================
*/

/* ============================================================================================== */
/* >TRANSFORMS                                                                                    */
/* ============================================================================================== */

/*
====================
trans2d

2D spatial transform component.
Stores:
- 2D position   `x`, `y` (in world units, default: <0.0f, 0.0f>)
- rotation      `rot`    (in radians,     default: 0.0f)
- uniform scale `scale`  (unitless,       default: 1.0f)
====================
*/
COMP(trans2d)
    FIELD(float, x,     0.0f)
    FIELD(float, y,     0.0f)
    FIELD(float, rot,   0.0f)
    FIELD(float, scale, 1.0f)
COMP_END(trans2d)

/*
====================
trans3d

3D spatial transform component.
Stores:
- 3D position    `x`,  `y`,  `z`        (in world units,        default: <0, 0, 0>)
- orientation    `qx`, `qy`, `qz`, `qw` (normalized quaternion, default: <0, 0, 0, 0>)
- per-axis scale `scale_x/y/z`          (unitless,              default: 1.0f)
====================
*/
COMP(trans3d)
    FIELD(float, x,       0.0f)
    FIELD(float, y,       0.0f)
    FIELD(float, z,       0.0f)
    FIELD(float, qx,      0.0f)
    FIELD(float, qy,      0.0f)
    FIELD(float, qz,      0.0f)
    FIELD(float, qw,      0.0f)
    FIELD(float, scale_x, 1.0f)
    FIELD(float, scale_y, 1.0f)
    FIELD(float, scale_z, 1.0f)
COMP_END(trans3d)

/* ============================================================================================== */
/* >RENDERING                                                                                     */
/* ============================================================================================== */

/*
====================
sprite2d

2D quad/sprite render descriptor.
Stores:
- texture ID    `id`        (atlas/sprite index,   default: 0 = `ASSET_SPRITE_WHITE`)
- sorting layer `layer`     (render order 0-255,   default: 0)
- flip flags    `flip_mask` (bitmask for H/V flip, default: 0)
- tint color    `color`     (packed 32-bit RGBA,   default: 0xFFFFFFFF)
====================
*/
COMP(sprite2d)
    FIELD(uint16_t, id,        0x0000)
    FIELD(uint8_t,  layer,     0x00)
    FIELD(uint8_t,  flip_mask, 0x00)
    FIELD(uint32_t, color,     0xFFFFFFFF)
COMP_END(sprite2d)

/*
====================
mesh3d

3D mesh render descriptor.
Stores:
- mesh ID    `mesh_id` (mesh registry index, default: 0 = `MESH_ID_CUBE`)
- texture ID `tex_id`  (atlas texture index, default: 0 = `ASSET_SPRITE_WHITE`)
- tint       `color`   (packed 32-bit RGBA, default: 0xFFFFFFFF)
====================
*/
COMP(mesh3d)
    FIELD(uint16_t, mesh_id, 0x0000)
    FIELD(uint16_t, tex_id,  0x0000)
    FIELD(uint32_t, color,   0xFFFFFFFF)
COMP_END(mesh3d)

/*
====================
light3d

3D light source. Position and direction come from entitys world `trans3d`
(direction = local -Z rotated by orientation).
Stores:
- light type `type`      (0=directional, 1=point, 2=spot,            default: 1)
- color      `color`     (packed RGBA 0xRRGGBBAA, alpha ignored,     default: 0xFFFFFFFF)
- intensity  `intensity` (linear multiplier,                         default: 1.0f)
- range      `range`     (point/spot falloff radius in world units,  default: 10.0f)
- cone       `cone_in`   (spot full-intensity half-angle in radians, default: 0.35f)
- cone       `cone_out`  (spot zero-intensity half-angle in radians, default: 0.5f)
====================
*/
COMP(light3d)
    FIELD(uint8_t,  type,      1)
    FIELD(uint8_t, _pad, 3,    {0})
    FIELD(uint32_t, color,     0xFFFFFFFF)
    FIELD(float,    intensity, 1.0f)
    FIELD(float,    range,     10.0f)
    FIELD(float,    cone_in,   0.35f)
    FIELD(float,    cone_out,  0.5f)
COMP_END(light3d)

/* ============================================================================================== */
/* >COLLISION & PHYSICS                                                                           */
/* ============================================================================================== */

/*
====================
collider2d

2D bounding volume (AABB, circle or upright capsule) collision shape.
Stores:
- half extents   `half_x/y` (box half-size, circle radius `half_x`, capsule radius `half_x` & half-height `half_y`, default: <0.0f, 0.0f>)
- center offset  `off_x/y`  (relative to entity transform,                                                          default: <0.0f, 0.0f>)
- layer mask     `mask`     (collision filter bitmask,                                                              default: 0x00000001)
- trigger sensor `trigger`  (true: detect overlap only,                                                             default: false)
- shape type     `shape`    (0=box, 1=circle, 2=capsule,                                                            default: 0)
====================
*/
COMP(collider2d)
    FIELD(float,    half_x,     0.0f)
    FIELD(float,    half_y,     0.0f)
    FIELD(float,    off_x,      0.0f)
    FIELD(float,    off_y,      0.0f)
    FIELD(uint32_t, mask,       0x00000001)
    FIELD(bool,     trigger,    false)
    FIELD(uint8_t,  shape,      0)
    FIELD(uint8_t,  _pad,    2, {0})
COMP_END(collider2d)

/*
====================
collider3d

3D bounding volume (AABB, sphere, or upright capsule) collision shape.
Stores:
- half extents  `half_x/y/z` (box half-size, sphere radius `half_x`, capsule radius `half_x` & half-height `half_y`, default: <0.0f, 0.0f, 0.0f>)
- center offset  `off_x/y/z` (relative to entity transform,                                                          default: <0.0f, 0.0f, 0.0f>)
- layer mask     `mask`      (collision filter bitmask,                                                              default: 0x00000001)
- trigger sensor `trigger`   (true: detect overlap only,                                                             default: false)
- shape type     `shape`     (0=box, 1=sphere, 2=capsule,                                                            default: 0)
====================
*/
COMP(collider3d)
    FIELD(float,    half_x,     0.0f)
    FIELD(float,    half_y,     0.0f)
    FIELD(float,    half_z,     0.0f)
    FIELD(float,    off_x,      0.0f)
    FIELD(float,    off_y,      0.0f)
    FIELD(float,    off_z,      0.0f)
    FIELD(uint32_t, mask,       0x00000001)
    FIELD(bool,     trigger,    false)
    FIELD(uint8_t,  shape,      0)
    FIELD(uint8_t, _pad,     2, {0})
COMP_END(collider3d)

/*
====================
rb2d

2D rigid body physics dynamics state.
Stores:
- linear velocity  `vel_x`, `vel_y` (units/second,                      default: <0.0f, 0.0f>)
- angular velocity `angular_vel`    (radians/second,                    default: 0.0f)
- inverse mass     `inv_mass`       (1/kg, 0.0f = static/infinite mass, default: 1.0f)
- linear damping   `drag`           (velocity decay coefficient,        default: 0.0f)
====================
*/
COMP(rb2d)
    FIELD(float, vel_x,       0.0f)
    FIELD(float, vel_y,       0.0f)
    FIELD(float, angular_vel, 0.0f)
    FIELD(float, inv_mass,    1.0f)
    FIELD(float, drag,        0.0f)
COMP_END(rb2d)

/*
====================
rb3d

3D rigid body physics dynamic state.
Stores:
- linear velocity  `vel_x/y/z`     (units/second,                      default: <0.0f, 0.0f, 0.0f>)
- angular velocity `ang_vel_x/y/z` (radians/second,                    default: <0.0f, 0.0f, 0.0f>)
- inverse mass     `inv_mass`      (1/kg, 0.0f = static/infinite mass, default: 1.0f)
- linear damping   `drag`          (velocity decay coefficient,        default: 0.0f)
- angular damping  `ang_drag`      (rotational decay coefficient,      default: 0.0f)
====================
*/
COMP(rb3d)
    FIELD(float, vel_x,     0.0f)
    FIELD(float, vel_y,     0.0f)
    FIELD(float, vel_z,     0.0f)
    FIELD(float, ang_vel_x, 0.0f)
    FIELD(float, ang_vel_y, 0.0f)
    FIELD(float, ang_vel_z, 0.0f)
    FIELD(float, inv_mass,  1.0f)
    FIELD(float, drag,      0.0f)
    FIELD(float, ang_drag,  0.0f)
COMP_END(rb3d)

/* ============================================================================================== */
/* >METADATA                                                                                      */
/* ============================================================================================== */

/*
====================
tag

Entity identification and debugging tag.
Stores:
- name `name` (fixed-size 32-byte null-terminated string, default: "")
====================
*/
COMP(tag)
    FIELD(char, name, 32, "")
COMP_END(tag)

/*
====================
hierarchy

Intrusive relational scene-tree node links.
Stores:
- parent entity      `parent`       (parent handle,        default: `ENTITY_NULL`)
- first child entity `first_child`  (head of child list,   default: `ENTITY_NULL`)
- previous sibling   `prev_sibling` (left sibling handle,  default: `ENTITY_NULL`)
- next sibling       `next_sibling` (right sibling handle, default: `ENTITY_NULL`)
- direct child count `child_cnt`    (number of children,   default: 0)
====================
*/
COMP(hierarchy)
    FIELD(entity_handle_t, parent,       ENTITY_NULL)
    FIELD(entity_handle_t, first_child,  ENTITY_NULL)
    FIELD(entity_handle_t, prev_sibling, ENTITY_NULL)
    FIELD(entity_handle_t, next_sibling, ENTITY_NULL)
    FIELD(uint32_t,        child_cnt,    0)
COMP_END(hierarchy)
